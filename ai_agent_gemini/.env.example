# ── Google Gemini API 설정 ──────────────────────────────
# Google AI Studio에서 발급: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaSy-your-key-here

# ── 모델 선택 (선택사항) ─────────────────────────────────
# CHART_MODEL=gemini-3.5-flash        # 기본값 (GA, 100만 토큰 컨텍스트)
# CHART_MODEL=gemini-3.1-pro-preview  # Pro 프리뷰
# CHART_MODEL=gemini-2.5-pro          # 이전 세대 Pro (안정)
# CHART_MODEL=gemini-2.5-flash        # 이전 세대 Flash (안정)

# ── 추론 수준 (Gemini 3.5 전용, temperature 대체) ────────
# temperature / top_p / top_k 는 Gemini 3.5에서 deprecated
# 아래 설정으로 품질/속도 트레이드오프 조정
# GEMINI_THINKING_LEVEL=minimal   # 최저 지연 (단순 분류)
# GEMINI_THINKING_LEVEL=low       # 빠름
# GEMINI_THINKING_LEVEL=medium    # 기본값 (균형)
# GEMINI_THINKING_LEVEL=high      # 최고 품질 (느림·비쌈)

# ── RAG 벡터DB 경로 (선택사항) ──────────────────────────
# ai_agent_1 의 벡터DB를 공유하려면:
# MISVIZ_DB_DIR=../ai_agent_1/misviz_vectordb
